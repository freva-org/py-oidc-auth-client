#!/usr/bin/env bash
# Before a push: what CI runs (lint, types, docs, packaging, tests on $PY),
# in the dev container. PREPUSH_ALL=1 tests every Python version instead.
#
# Turned on by `just setup`, `just dev` or `just hooks`; off with
# `just hooks-off`. Skip once with `git push --no-verify`, or for a whole
# shell with SKIP_HOOKS=1.
set -euo pipefail

[ "${SKIP_HOOKS:-0}" = "1" ] && exit 0

# git passes "<local ref> <local sha> <remote ref> <remote sha>" per ref on
# stdin. A local sha of only zeros deletes the remote ref: nothing to check.
pushes_commits=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  if [[ ! "$local_sha" =~ ^0+$ ]]; then
    pushes_commits=1
  fi
done
[ "$pushes_commits" = "1" ] || exit 0

cd "$(git rev-parse --show-toplevel)"
if [ "${PREPUSH_ALL:-0}" = "1" ]; then
  just _hook pre-push lint types docs pkg </dev/null
  exec just test-all </dev/null
fi
exec just _hook pre-push lint types docs pkg test </dev/null
